# Twilio (outbound voice calls)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token

# Google Gemini (chat, voice, embeddings, summaries)
GEMINI_API_KEY=your_gemini_api_key

# Scrappa (structured search — flights, hotels, shopping)
SCRAPPA_API_KEY=your_scrappa_api_key

# Browser Use (optional — leave empty to use Gemini for browser tasks)
BROWSER_USE_API_KEY=

# Cartesia (TTS + STT for voice calls)
CARTESIA_API_KEY=your_cartesia_api_key

# Database (SQLite — defaults to sniff.db in project root)
# DB_PATH=sniff.db

# App
APP_BASE_URL=https://your-tunnel-or-domain.com
